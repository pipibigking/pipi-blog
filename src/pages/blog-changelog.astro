---
import { Icon } from "astro-icon/components";
import { blogChangelogEntries } from "@/data/blog-changelog";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 只保留一条「博客成长轨迹」：不再重复展示按日更新记录与折叠框。
const latest = blogChangelogEntries[0];
const versionSteps = [...new Set(["V1.0.0", "V1.5.0", "V2.0.0", "V2.3.0", "V3.0.0", latest.version])];
const milestones = versionSteps.map((version) => {
	const entry = blogChangelogEntries.find((item) => item.version === version) ?? latest;
	return {
		version,
		label: entry.kind,
		date: entry.date.replaceAll("-", "."),
		current: version === latest.version,
	};
});
---

<MainGridLayout title="博客更新日志" description="屁屁大王博客的成长轨迹">
	<section class="growth-page" aria-labelledby="growth-title">
		<header class="growth-hero card-base">
			<div class="growth-kicker">
				<Icon is:inline name="material-symbols:auto-awesome-rounded" aria-hidden="true" />
				<span>BLOG CHANGELOG</span>
				<i aria-hidden="true"></i>
				<span>PUBLIC RECORD</span>
			</div>
			<h1 id="growth-title">博客成长轨迹</h1>
			<p>从第一次上线到现在，每一次改版都留下一枚路标。这里只保留一条主线，回看时更清楚。</p>
		</header>

		<nav class="growth-nav card-base" aria-label="日志页面导航">
			<a href="/about/">
				<Icon is:inline name="material-symbols:arrow-back-rounded" aria-hidden="true" />
				关于我
			</a>
			<span>持续更新 · 一步一个脚印</span>
		</nav>

		<section class="growth-board card-base" aria-labelledby="growth-board-title">
			<div class="growth-board__heading">
				<div>
					<span class="growth-board__mark" aria-hidden="true"></span>
					<h2 id="growth-board-title">成长轨迹</h2>
				</div>
				<span>{latest.version} · 当前版本</span>
			</div>

			<ol class="growth-track">
				{milestones.map((milestone) => (
					<li class:list={["growth-node", { "is-current": milestone.current }]}>
						<span class="growth-node__dot" aria-hidden="true"></span>
						<article class="growth-node__card">
							<div class="growth-node__top">
								<strong>{milestone.version}</strong>
								{milestone.current && (
									<span class="growth-node__badge">
										<Icon is:inline name="material-symbols:workspace-premium-rounded" aria-hidden="true" />
										当前
									</span>
								)}
							</div>
							<time>{milestone.date}</time>
							<span class="growth-node__label">{milestone.label}</span>
						</article>
					</li>
				))}
			</ol>

			<p class="growth-board__note">一步一个脚印，让热爱继续发光 <span aria-hidden="true">✦</span></p>
		</section>
	</section>
</MainGridLayout>

<style>
	.growth-page {
		width: 100%;
		max-width: 74rem;
		margin: 0 auto;
		padding-bottom: 1.5rem;
	}

	.growth-hero {
		position: relative;
		overflow: hidden;
		min-height: clamp(12rem, 18vw, 16rem);
		padding: clamp(1.45rem, 3vw, 2.45rem);
		border: 1px solid var(--line-divider);
		background:
			linear-gradient(90deg, rgb(255 255 255 / 96%) 0%, rgb(255 255 255 / 88%) 34%, rgb(255 255 255 / 42%) 68%, rgb(255 255 255 / 12%) 100%),
			url("/assets/images/blog-changelog/blog-changelog-hero.webp") center right / cover no-repeat !important;
	}

	:root.dark .growth-hero {
		background:
			linear-gradient(90deg, rgb(17 25 42 / 94%) 0%, rgb(17 25 42 / 86%) 34%, rgb(17 25 42 / 44%) 68%, rgb(17 25 42 / 14%) 100%),
			url("/assets/images/blog-changelog/blog-changelog-hero.webp") center right / cover no-repeat !important;
	}

	.growth-hero::after {
		content: "";
		position: absolute;
		right: -8rem;
		bottom: -10rem;
		width: 22rem;
		height: 22rem;
		border-radius: 50%;
		background: radial-gradient(circle, color-mix(in srgb, var(--primary) 16%, transparent), transparent 68%);
		pointer-events: none;
	}

	.growth-kicker {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--primary);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.growth-kicker svg { width: 1.1rem; height: 1.1rem; }
	.growth-kicker i { width: 1.5rem; height: 1px; background: currentColor; opacity: 0.5; }

	.growth-hero h1 {
		position: relative;
		margin: 1.5rem 0 0.7rem;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		font-weight: 700;
		line-height: 1.3;
	}

	.growth-hero > p {
		position: relative;
		max-width: 36rem;
		color: var(--text-color);
		opacity: 0.76;
		font-size: 0.92rem;
		line-height: 1.8;
	}

	.growth-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 1.25rem 0;
		padding: 0.8rem 1.1rem;
		font-size: 0.82rem;
		color: var(--text-color);
		opacity: 0.85;
	}

	.growth-nav a { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--primary); }
	.growth-nav a:hover { text-decoration: underline; }
	.growth-nav svg { width: 1rem; height: 1rem; }

	.growth-board {
		position: relative;
		overflow: hidden;
		padding: clamp(1.25rem, 2.5vw, 2rem);
		border: 1px solid var(--line-divider);
	}

	.growth-board::before {
		content: "";
		position: absolute;
		inset: 0 auto 0 0;
		width: 18rem;
		background: radial-gradient(circle at 0 50%, color-mix(in srgb, var(--primary) 8%, transparent), transparent 70%);
		pointer-events: none;
	}

	.growth-board__heading {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.8rem;
	}

	.growth-board__heading > div { display: flex; align-items: center; gap: 0.65rem; }
	.growth-board__heading h2 { font-size: 1.15rem; font-weight: 650; }
	.growth-board__heading > span { font-size: 0.78rem; color: var(--primary); opacity: 0.85; }

	.growth-board__mark {
		width: 0.5rem;
		height: 1.05rem;
		border-radius: 999px;
		background: linear-gradient(180deg, var(--primary), color-mix(in srgb, var(--primary) 30%, #fff));
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 12%, transparent);
	}

	.growth-track {
		position: relative;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1rem;
		padding: 0;
		list-style: none;
	}

	.growth-track::before {
		content: "";
		position: absolute;
		top: 0.4rem;
		left: 1rem;
		right: 1rem;
		height: 1px;
		background: repeating-linear-gradient(90deg, color-mix(in srgb, var(--primary) 36%, var(--line-divider)) 0 6px, transparent 6px 11px);
	}

	.growth-node { position: relative; padding-top: 1.1rem; }

	.growth-node__dot {
		position: absolute;
		top: 0.15rem;
		left: 0.6rem;
		width: 0.7rem;
		height: 0.7rem;
		border: 2px solid var(--card-bg);
		border-radius: 50%;
		background: color-mix(in srgb, var(--primary) 55%, var(--line-divider));
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 45%, transparent);
	}

	.growth-node.is-current .growth-node__dot {
		background: var(--primary);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 18%, transparent);
	}

	/* 友链卡片里学来的装饰：异形圆角 + 歪斜虚线徽章 + 掠光 */
	.growth-node__card {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 0.9rem 0.95rem;
		border: 1px solid var(--line-divider);
		border-radius: 10px 7px 12px 8px;
		background: color-mix(in srgb, var(--card-bg) 80%, transparent);
		transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
	}

	.growth-node__card::after {
		content: "";
		position: absolute;
		top: 0;
		left: -60%;
		width: 45%;
		height: 100%;
		transform: skewX(-22deg);
		background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--primary) 16%, transparent), transparent);
		pointer-events: none;
	}

	.growth-node__card:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--primary) 45%, var(--line-divider));
		box-shadow: 0 0.6rem 1.2rem color-mix(in srgb, var(--primary) 12%, transparent);
	}

	.growth-node__card:hover::after { animation: growth-sweep 900ms ease-out; }

	@keyframes growth-sweep {
		from { left: -60%; }
		to { left: 130%; }
	}

	.growth-node__top { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; }
	.growth-node__top strong { font-size: 1.05rem; font-weight: 700; color: var(--primary); }
	.growth-node__card time {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.72rem;
		opacity: 0.68;
		font-variant-numeric: tabular-nums;
	}
	.growth-node__label { display: block; margin-top: 0.5rem; font-size: 0.78rem; opacity: 0.85; }

	.growth-node__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.12rem 0.42rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 45%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 10%, transparent);
		font-size: 0.66rem;
		transform: rotate(-3deg);
	}
	.growth-node__badge svg { width: 0.8rem; height: 0.8rem; }

	.growth-board__note { margin-top: 1.8rem; text-align: center; font-size: 0.8rem; opacity: 0.7; }
	.growth-board__note span { color: var(--primary); }

	@media (max-width: 640px) {
		.growth-nav { align-items: flex-start; flex-direction: column; gap: 0.3rem; }
		.growth-track { grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr)); gap: 0.65rem; }
		.growth-node__card { padding: 0.7rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.growth-node__card { transition: none; }
		.growth-node__card:hover::after { animation: none; }
	}
</style>
