---
import { Icon } from "astro-icon/components";
import { resumeConfig } from "@/config/resumeConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";
---

<MainGridLayout title="我的简历" description="屁屁大王的个人简历与项目作品集">
	<section class="resume-page" aria-labelledby="resume-title">
		<header class="resume-hero card-base">
			<div class="resume-kicker">
				<Icon is:inline name="material-symbols:description-rounded" aria-hidden="true" />
				<span>RESUME / PORTFOLIO</span>
			</div>
			<div class="resume-hero__main">
				<div>
					<h1 id="resume-title">我的简历</h1>
					<p>把做过的项目、写过的代码和想说的话，放进这一页。左侧是作品本身，右侧是它背后的故事。</p>
				</div>
				{
					resumeConfig.resumePdf ? (
						<a class="resume-download" href={url(resumeConfig.resumePdf)} download>
							<Icon is:inline name="material-symbols:download-rounded" aria-hidden="true" />
							下载 PDF 简历
						</a>
					) : (
						<span class="resume-download resume-download--placeholder" title="把 PDF 放进 public/assets/files/ 并修改 resumeConfig.ts">
							<Icon is:inline name="material-symbols:download-rounded" aria-hidden="true" />
							PDF 简历准备中
						</span>
					)
				}
			</div>
		</header>

		<nav class="resume-tabs card-base" aria-label="关于我页面导航">
			<a href="/about/">
				<Icon is:inline name="material-symbols:person-outline-rounded" aria-hidden="true" />
				<span>个人资料</span>
			</a>
			<a href="/resume/" aria-current="page" class="is-active">
				<Icon is:inline name="material-symbols:description-rounded" aria-hidden="true" />
				<span>我的简历</span>
			</a>
		</nav>

		<div class="resume-list-heading">
			<div>
				<p>PROJECTS</p>
				<h2>项目展示</h2>
			</div>
			<span>左侧作品 · 右侧介绍</span>
		</div>

		<div class="resume-projects">
			{resumeConfig.projects.map((project) => (
				<article class="resume-project card-base">
					<!-- 左侧：项目实体（视频优先，其次封面 / 链接） -->
					<div class="resume-project__media">
						{project.video ? (
							<video
								class="resume-project__video"
								controls
								preload="metadata"
								poster={project.poster ? url(project.poster) : undefined}
								aria-label={`${project.title} 项目视频`}
							>
								<source src={url(project.video)} />
							</video>
						) : project.poster ? (
							<a class="resume-project__poster" href={project.link ? url(project.link) : "#"} aria-label={project.title}>
								<img src={url(project.poster)} alt={project.title} loading="lazy" />
								<span class="resume-project__play" aria-hidden="true">
									<Icon is:inline name="material-symbols:arrow-outward-rounded" />
								</span>
							</a>
						) : (
							<a
								class:list={["resume-project__placeholder", project.link && "is-linked"]}
								href={project.link ? url(project.link) : "#"}
								aria-label={project.title}
							>
								<Icon is:inline name="material-symbols:movie-rounded" aria-hidden="true" />
								<span>项目视频 / 封面位</span>
								<small>在 resumeConfig.ts 中填写 video、poster 或 link</small>
							</a>
						)}
						{project.featured && (
							<span class="resume-project__ribbon">
								<Icon is:inline name="material-symbols:star-rounded" aria-hidden="true" />
								FEATURED
							</span>
						)}
					</div>

					<!-- 右侧：项目介绍 -->
					<div class="resume-project__body">
						<div class="resume-project__meta">
							<span>{project.year}</span>
							<i aria-hidden="true"></i>
							<span>{project.category}</span>
						</div>
						<h3>{project.title}</h3>
						<p class="resume-project__description">{project.description}</p>

						{project.highlights && project.highlights.length > 0 && (
							<ul class="resume-project__highlights">
								{project.highlights.map((item) => (
									<li>
										<Icon is:inline name="material-symbols:check-circle-rounded" aria-hidden="true" />
										<span>{item}</span>
									</li>
								))}
							</ul>
						)}

						<div class="resume-project__tags">
							{project.tags.map((tag) => <span>{tag}</span>)}
						</div>

						{project.link && (
							<a class="resume-project__link" href={url(project.link)}>
								{project.linkLabel || "查看项目"}
								<Icon is:inline name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
							</a>
						)}
					</div>
				</article>
			))}
		</div>
	</section>
</MainGridLayout>

<style>
	.resume-page {
		width: 100%;
		max-width: 74rem;
		margin: 0 auto;
		padding-bottom: 1.5rem;
	}

	.resume-hero {
		position: relative;
		overflow: hidden;
		padding: clamp(1.4rem, 3vw, 2.3rem);
		border: 1px solid var(--line-divider);
		background-color: var(--card-bg) !important;
	}

	.resume-hero::after {
		content: "";
		position: absolute;
		right: -7rem;
		bottom: -11rem;
		width: 24rem;
		height: 24rem;
		border-radius: 50%;
		background: radial-gradient(circle, color-mix(in srgb, var(--primary) 14%, transparent), transparent 68%);
		pointer-events: none;
	}

	.resume-kicker {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--primary);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}
	.resume-kicker svg { width: 1.05rem; height: 1.05rem; }

	.resume-hero__main {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-top: 1.3rem;
	}

	.resume-hero h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 700; line-height: 1.3; }
	.resume-hero p { max-width: 38rem; margin-top: 0.6rem; font-size: 0.88rem; line-height: 1.8; opacity: 0.78; }

	.resume-download {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.45rem;
		padding: 0.6rem 1rem;
		border: 1px solid color-mix(in srgb, var(--primary) 45%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 10%, transparent);
		color: var(--primary);
		font-size: 0.82rem;
		text-decoration: none;
		transition: background-color 200ms ease, transform 200ms ease;
	}
	.resume-download:hover { background: color-mix(in srgb, var(--primary) 18%, transparent); transform: translateY(-2px); }
	.resume-download svg { width: 1rem; height: 1rem; }
	.resume-download--placeholder { border-style: dashed; opacity: 0.65; cursor: default; }
	.resume-download--placeholder:hover { background: color-mix(in srgb, var(--primary) 10%, transparent); transform: none; }

	.resume-tabs {
		display: flex;
		gap: 1.5rem;
		margin: 1.2rem 0 1.6rem;
		padding: 0.3rem 1rem;
	}
	.resume-tabs a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.7rem 0.2rem;
		border-bottom: 2px solid transparent;
		color: var(--text-color);
		opacity: 0.68;
		font-size: 0.85rem;
		text-decoration: none;
	}
	.resume-tabs a svg { width: 1rem; height: 1rem; }
	.resume-tabs a.is-active { border-bottom-color: var(--primary); color: var(--primary); opacity: 1; font-weight: 600; }

	.resume-list-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.9rem;
	}
	.resume-list-heading p { color: var(--primary); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.16em; }
	.resume-list-heading h2 { margin-top: 0.15rem; font-size: 1.15rem; font-weight: 650; }
	.resume-list-heading > span { font-size: 0.76rem; opacity: 0.65; }

	.resume-projects { display: flex; flex-direction: column; gap: 1.1rem; }

	/* 左实体 / 右介绍 */
	.resume-project {
		display: grid;
		grid-template-columns: minmax(15rem, 40%) minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--line-divider);
		border-radius: 12px 9px 14px 10px;
		transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
	}

	.resume-project:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--primary) 42%, var(--line-divider));
		box-shadow: 0 0.7rem 1.4rem color-mix(in srgb, var(--primary) 10%, transparent);
	}

	.resume-project__media {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 13rem;
		border-radius: 9px 6px 11px 7px;
		background: color-mix(in srgb, var(--primary) 6%, var(--card-bg));
	}

	.resume-project__video,
	.resume-project__poster,
	.resume-project__placeholder {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 13rem;
	}

	.resume-project__video { object-fit: cover; background: #000; }
	.resume-project__poster img { width: 100%; height: 100%; min-height: 13rem; object-fit: cover; }
	.resume-project__play {
		position: absolute;
		right: 0.7rem;
		bottom: 0.7rem;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid rgba(255, 255, 255, 0.5);
		border-radius: 50%;
		background: color-mix(in srgb, var(--primary) 75%, transparent);
		color: #fff;
		backdrop-filter: blur(4px);
	}

	.resume-project__placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 35%, var(--line-divider));
		color: var(--text-color);
		text-decoration: none;
		opacity: 0.7;
	}
	.resume-project__placeholder svg { width: 2rem; height: 2rem; color: var(--primary); }
	.resume-project__placeholder span { font-size: 0.85rem; }
	.resume-project__placeholder small { font-size: 0.68rem; opacity: 0.7; }
	.resume-project__placeholder.is-linked:hover { opacity: 1; }

	/* 友链徽章手法：歪斜虚线底板 + 扫光 */
	.resume-project__ribbon {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.22rem 0.6rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 55%, transparent);
		border-radius: 10px 7px 12px 8px;
		background: color-mix(in srgb, var(--primary) 14%, var(--card-bg));
		backdrop-filter: blur(2px);
		color: var(--primary);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		transform: rotate(-3deg);
	}
	.resume-project__ribbon svg { width: 0.85rem; height: 0.85rem; }

	.resume-project__body { min-width: 0; padding: 0.4rem 0.6rem 0.4rem 0; }
	.resume-project__meta { display: flex; align-items: center; gap: 0.6rem; font-size: 0.72rem; color: var(--primary); opacity: 0.85; }
	.resume-project__meta i { width: 1.2rem; height: 1px; background: currentColor; opacity: 0.6; }
	.resume-project h3 { margin: 0.5rem 0 0.55rem; font-size: 1.15rem; font-weight: 650; line-height: 1.5; }
	.resume-project__description { font-size: 0.85rem; line-height: 1.85; opacity: 0.82; }

	.resume-project__highlights {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
	}
	.resume-project__highlights li { display: flex; align-items: flex-start; gap: 0.45rem; font-size: 0.8rem; line-height: 1.6; opacity: 0.85; }
	.resume-project__highlights svg { flex: 0 0 auto; width: 0.9rem; height: 0.9rem; margin-top: 0.2rem; color: var(--primary); }

	.resume-project__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
	.resume-project__tags span {
		padding: 0.2rem 0.55rem;
		border: 1px solid var(--line-divider);
		border-radius: 999px;
		background: color-mix(in srgb, var(--card-bg) 80%, transparent);
		font-size: 0.7rem;
		opacity: 0.85;
	}

	.resume-project__link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 1rem;
		color: var(--primary);
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
	}
	.resume-project__link:hover { text-decoration: underline; }
	.resume-project__link svg { width: 0.95rem; height: 0.95rem; }

	/* 暗色主题：提高卡片与标签的不透明度，保证亮壁纸下仍有足够对比度 */
	:root.dark .resume-hero,
	:root.dark .resume-tabs,
	:root.dark .resume-project {
		border-color: rgba(255, 255, 255, 0.14);
		background-color: var(--card-bg) !important;
		color: var(--text-color);
	}

	:root.dark .resume-project__media {
		background: color-mix(in srgb, var(--card-bg) 94%, var(--page-bg));
	}

	:root.dark .resume-project:hover {
		border-color: color-mix(in srgb, var(--primary) 50%, rgba(255, 255, 255, 0.16));
		box-shadow: 0 0.7rem 1.4rem rgba(0, 0, 0, 0.4);
	}

	:root.dark .resume-project__tags span {
		border-color: rgba(255, 255, 255, 0.12);
		background: color-mix(in srgb, var(--card-bg) 92%, var(--page-bg));
		color: var(--text-color);
	}

	:root.dark .resume-project__ribbon {
		background: color-mix(in srgb, var(--primary) 18%, var(--card-bg));
	}

	@media (max-width: 767px) {
		.resume-hero__main { align-items: flex-start; flex-direction: column; gap: 1rem; }
		.resume-project { grid-template-columns: minmax(0, 1fr); gap: 0.9rem; }
		.resume-project__body { padding: 0 0.25rem 0.25rem; }
		.resume-project__media,
		.resume-project__video,
		.resume-project__poster,
		.resume-project__poster img,
		.resume-project__placeholder { min-height: 11rem; }
		.resume-tabs { gap: 1rem; padding: 0.2rem 0.7rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.resume-project { transition: none; }
	}
</style>
