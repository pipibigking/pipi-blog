---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 工具页占位：此前的第三方工具清单已移除，后续会替换为站主自制工具。
// 上架时在 below 数组中按 { name, description, icon, url } 结构补充即可。
const placeholderHint = "这里未来会展示屁屁大王自己动手做的工具，敬请期待";
---

<MainGridLayout title="工具" description="屁屁大王的工具箱">
	<section class="tools-page">
		<header class="tools-hero card-base">
			<div class="tools-kicker">
				<Icon is:inline name="material-symbols:construction-rounded" />
				<span>TOOLS</span>
			</div>
			<h1>工具箱</h1>
			<p>我的工具正在打磨中，敬请期待。</p>
		</header>

		<section class="tools-placeholder card-base" aria-label="工具占位">
			<Icon is:inline name="material-symbols:construction-rounded" aria-hidden="true" />
			<h2>筹备中</h2>
			<p>{placeholderHint}</p>
			<a href="/" class="tools-placeholder__back">
				<Icon is:inline name="material-symbols:arrow-back-rounded" aria-hidden="true" />
				<span>回到主页</span>
			</a>
		</section>
	</section>
</MainGridLayout>

<style>
	.tools-page {
		width: 100%;
		max-width: 74rem;
		margin: 0 auto;
		padding-bottom: 1.5rem;
	}

	.tools-hero {
		position: relative;
		overflow: hidden;
		padding: clamp(1.45rem, 3vw, 2.45rem);
		border: 1px solid var(--line-divider);
		background-color: var(--card-bg) !important;
	}

	.tools-hero::after {
		content: "";
		position: absolute;
		right: -8rem;
		bottom: -10rem;
		width: 22rem;
		height: 22rem;
		border-radius: 50%;
		background: radial-gradient(circle, color-mix(in srgb, var(--primary) 15%, transparent), transparent 68%);
		pointer-events: none;
	}

	.tools-kicker {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--content-meta);
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.1em;
	}

	.tools-kicker svg {
		color: var(--primary);
	}

	.tools-hero h1 {
		position: relative;
		z-index: 1;
		margin: 0.65rem 0;
		color: var(--text-color);
		font-size: clamp(2rem, 4vw, 3.2rem);
		font-weight: 850;
		letter-spacing: -0.035em;
		line-height: 1.05;
	}

	.tools-hero p {
		position: relative;
		z-index: 1;
		margin: 0;
		color: var(--content-meta);
		font-size: 0.92rem;
		line-height: 1.85;
	}

	.tools-placeholder {
		display: grid;
		justify-items: center;
		gap: 0.65rem;
		margin-top: 1rem;
		padding: clamp(2.2rem, 6vw, 4rem) 1.5rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 32%, var(--line-divider));
		border-radius: 0.9rem;
		background-color: var(--card-bg) !important;
		text-align: center;
	}

	.tools-placeholder svg {
		color: var(--primary);
		font-size: 2.6rem;
		opacity: 0.85;
	}

	.tools-placeholder h2 {
		margin: 0;
		color: var(--text-color);
		font-size: 1.05rem;
		font-weight: 820;
		letter-spacing: -0.02em;
	}

	.tools-placeholder p {
		margin: 0;
		color: var(--content-meta);
		font-size: 0.8rem;
		line-height: 1.75;
	}

	.tools-placeholder__back {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 0.5rem;
		padding: 0.45rem 0.9rem;
		border: 1px solid color-mix(in srgb, var(--primary) 22%, var(--line-divider));
		border-radius: 999px;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 760;
		text-decoration: none;
		transition: background-color 180ms ease, color 180ms ease;
	}

	.tools-placeholder__back:hover,
	.tools-placeholder__back:focus-visible {
		background-color: color-mix(in srgb, var(--primary) 10%, transparent);
		outline: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.tools-placeholder__back {
			transition: none;
		}
	}
</style>
