---
import { Icon } from "astro-icon/components";
import FavoritesGrid from "@/components/pages/anime/FavoritesGrid.svelte";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { FavoriteVideo } from "@/types/favorites";
import { formatDateI18nWithTime } from "@/utils/date-utils";
import favoritesCache from "@/data/favorites-cache.json";

// 检查页面是否启用
if (!siteConfig.pages.anime) {
	return Astro.redirect("/404/");
}

const buildTime = formatDateI18nWithTime(new Date());
let cacheDate = buildTime;

// ============ B 站收藏数据 ============
// 优先使用本地缓存快照（由 .tmp/fetch-favorites.mjs 抓取生成），避免 B 站接口风控导致页面空白。
// 需要更新收藏时：node .tmp/fetch-favorites.mjs 重新生成 src/data/favorites-cache.json 即可。
const uid = siteConfig.anime?.bilibili?.uid;
const cached = favoritesCache as {
	fetchedAt: number;
	uid: string;
	videos: FavoriteVideo[];
	folders: { id: number; title: string; count: number }[];
};

const videos: FavoriteVideo[] = cached.videos || [];
const folders = cached.folders || [];
cacheDate = formatDateI18nWithTime(new Date(cached.fetchedAt));
console.log(
	`[Favorites] ${videos.length} videos from ${folders.length} folders (cache ${cacheDate})`,
);

const upCount = new Set(videos.map((v) => v.upMid)).size;
const isConfigured = !!uid;
---

<MainGridLayout title={i18n(I18nKey.anime)} description={i18n(I18nKey.animeSubtitle)}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="relative w-full mb-8">
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
              <Icon is:inline name="material-symbols:bookmark" class="text-[1.5rem]"></Icon>
            </div>
            <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
              {i18n(I18nKey.anime)}
            </div>
          </div>
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {i18n(I18nKey.animeSubtitle)}
          </p>
          <p class="text-xs text-neutral-500 dark:text-neutral-500 mt-2">
            数据来源 Bilibili · {i18n(I18nKey.animeLastUpdated)} {cacheDate}
          </p>
        </div>

        {!isConfigured ? (
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon is:inline name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              未配置 B 站 UID
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              请在站点配置中填写 Bilibili UID 后重新构建。
            </p>
          </div>
        ) : (
          <>
            <!-- 统计卡片 -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4 mb-6">
              <div class="bg-(--card-bg) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
                <div class="flex items-center gap-2 sm:gap-3">
                  <div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-(--primary)/10 flex items-center justify-center shrink-0">
                    <Icon is:inline name="material-symbols:video-library" class="text-[1rem] sm:text-[1.25rem] text-(--primary)" />
                  </div>
                  <div class="min-w-0">
                    <div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">收藏视频</div>
                    <div class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">{videos.length}</div>
                  </div>
                </div>
              </div>
              <div class="bg-(--card-bg) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
                <div class="flex items-center gap-2 sm:gap-3">
                  <div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-pink-500/10 flex items-center justify-center shrink-0">
                    <Icon is:inline name="material-symbols:folder" class="text-[1rem] sm:text-[1.25rem] text-pink-500" />
                  </div>
                  <div class="min-w-0">
                    <div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">收藏夹</div>
                    <div class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">{folders.length}</div>
                  </div>
                </div>
              </div>
              <div class="bg-(--card-bg) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
                <div class="flex items-center gap-2 sm:gap-3">
                  <div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-yellow-500/10 flex items-center justify-center shrink-0">
                    <Icon is:inline name="material-symbols:person" class="text-[1rem] sm:text-[1.25rem] text-yellow-500" />
                  </div>
                  <div class="min-w-0">
                    <div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">UP 主</div>
                    <div class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">{upCount}</div>
                  </div>
                </div>
              </div>
            </div>

            <FavoritesGrid client:load items={videos} {folders} />
          </>
        )}
      </div>
    </div>
  </div>
</MainGridLayout>
