---
/**
 * Pure 站点主题的独立导航栏
 * --------------------------------------------------------------------------
 * 不复用 Aemeath 的胶囊导航 DOM：上游 Pure 的头部是「文字品牌 + 纯文字菜单 +
 * 图标按钮」的极简结构，滚动后才浮出一块带细边框的实底面板。
 * 这里按同样的结构单独渲染，切换站点主题时由 CSS 决定显示哪一个。
 */
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import SiteThemeSwitch from "@/components/controls/SiteThemeSwitch.svelte";
import { navBarConfig, siteConfig } from "@/config";
import type { NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { url } from "@/utils/url-utils";

import "@/styles/pure-navbar.css";

const pages = siteConfig.pages;

function isPageEnabled(link: NavBarLink): boolean {
	if (!link.pageKey) return true;
	return pages[link.pageKey as keyof typeof pages] !== false;
}

function filterLinks(link: NavBarLink): NavBarLink | null {
	if (!link.children) return isPageEnabled(link) ? link : null;
	const children = link.children.filter(isPageEnabled);
	if (children.length === 0) return null;
	if (children.length === 1) return children[0];
	return { ...link, children };
}

const links: NavBarLink[] = navBarConfig.links
	.map(filterLinks)
	.filter((link): link is NavBarLink => link !== null);

const navbarTitle = siteConfig.navbar.title || siteConfig.title;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const normalize = (value: string) => {
	if (!value || value === "#") return "";
	let pathname = value;
	try {
		pathname = value.startsWith("http") ? new URL(value).pathname : value;
	} catch {
		pathname = value;
	}
	pathname = pathname.split(/[?#]/)[0] || "/";
	return pathname.replace(/\/+$/, "") || "/";
};

const isActive = (link: NavBarLink): boolean => {
	const own = normalize(link.url);
	if (own) {
		if (own === "/") return currentPath === "/";
		if (currentPath === own || currentPath.startsWith(`${own}/`)) return true;
	}
	return Boolean(link.children?.some(isActive));
};

const href = (link: NavBarLink) =>
	link.external || link.url === "#" ? link.url : url(link.url);

// 品牌头像：与 Aemeath 导航共用同一份配置，缺失时退化为纯文字品牌
const logoValue = siteConfig.navbar.logo?.value || "";
const isLocalSrcLogo =
	siteConfig.navbar.logo?.type === "image" &&
	logoValue &&
	!logoValue.startsWith("/") &&
	!logoValue.startsWith("http");
let logoImg: ImageMetadata | null = null;

if (isLocalSrcLogo) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", logoValue))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) logoImg = await file();
}
const avatarUrl =
	siteConfig.navbar.logo?.type === "url"
		? siteConfig.navbar.logo.value
		: siteConfig.navbar.logo?.type === "image" && !isLocalSrcLogo
			? url(logoValue)
			: "";
---

<header
	class="pure-navbar"
	id="pure-navbar"
	data-pagefind-ignore="all"
	aria-label="站点导航"
>
	<!-- 阅读进度：贴视口顶部的一条 2px 主题色细线，只在开始滚动后浮现 -->
	<div class="pure-progress" id="pure-progress" aria-hidden="true">
		<span class="pure-progress__fill" id="pure-progress-fill"></span>
	</div>
	<div class="pure-navbar__bar">
		<a class="pure-brand" href={url("/")}>
			{logoImg ? (
				<Picture
					src={logoImg}
					alt=""
					class="pure-brand__avatar"
					formats={getImageFormats()}
					fallbackFormat={getFallbackFormat()}
					widths={[24, 48]}
					loading="eager"
					fetchpriority="high"
					aria-hidden="true"
				/>
			) : avatarUrl ? (
				<img
					class="pure-brand__avatar"
					src={avatarUrl}
					alt=""
					aria-hidden="true"
				/>
			) : (
				<span class="pure-brand__dot" aria-hidden="true"></span>
			)}
			<span class="pure-brand__text">{navbarTitle}</span>
		</a>

		<nav class="pure-nav" aria-label="主导航">
			{
				links.map((link) =>
					link.children ? (
						<details class="pure-nav__group">
							<summary class:list={[isActive(link) && "is-current"]}>
								<span>{link.name}</span>
								<svg
									class="pure-nav__chevron"
									viewBox="0 0 24 24"
									fill="none"
									aria-hidden="true"
								>
									<path
										d="m6 9 6 6 6-6"
										stroke="currentColor"
										stroke-width="1.9"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</summary>
							<div class="pure-nav__menu">
								{link.children.map((child) => (
									<a
										href={href(child)}
										target={child.external ? "_blank" : undefined}
										rel={child.external ? "noopener noreferrer" : undefined}
										aria-current={isActive(child) ? "page" : undefined}
										class:list={[isActive(child) && "is-current"]}
										data-pure-path={child.external ? undefined : normalize(child.url)}
									>
										{child.name}
									</a>
								))}
							</div>
						</details>
					) : (
						<a
							href={href(link)}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noopener noreferrer" : undefined}
							aria-current={isActive(link) ? "page" : undefined}
							class:list={[isActive(link) && "is-current"]}
							data-pure-path={link.external ? undefined : normalize(link.url)}
						>
							{link.name}
						</a>
					),
				)
			}
		</nav>

		<div class="pure-actions">
			<a
				class="pure-icon-btn pure-search-btn"
				href={url("/search/")}
				aria-label="搜索"
				title="搜索"
			>
				<Icon is:inline name="material-symbols:search-rounded" />
			</a>
			<LightDarkSwitch client:load />
			<SiteThemeSwitch client:load />
			<button
				type="button"
				class="pure-icon-btn pure-menu-btn"
				id="pure-menu-switch"
				aria-label="展开导航"
				aria-controls="pure-drawer"
				aria-expanded="false"
			>
				<Icon is:inline name="material-symbols:menu-rounded" class="pure-menu-icon" />
				<Icon is:inline name="material-symbols:close-rounded" class="pure-menu-icon-close" />
			</button>
		</div>
	</div>

	<div class="pure-drawer" id="pure-drawer">
		<nav class="pure-drawer__nav" aria-label="移动端主导航">
			{
				links.map((link) =>
					link.children ? (
						<details class="pure-drawer__group">
							<summary class:list={[isActive(link) && "is-current"]}>
								<span>{link.name}</span>
								<svg class="pure-nav__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</summary>
							<div class="pure-drawer__links">
								{link.children.map((child) => (
									<a
										href={href(child)}
										target={child.external ? "_blank" : undefined}
										rel={child.external ? "noopener noreferrer" : undefined}
										class:list={[isActive(child) && "is-current"]}
										data-pure-path={child.external ? undefined : normalize(child.url)}
									>
										{child.name}
									</a>
								))}
							</div>
						</details>
					) : (
						<a
							href={href(link)}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noopener noreferrer" : undefined}
							class:list={[isActive(link) && "is-current"]}
							data-pure-path={link.external ? undefined : normalize(link.url)}
						>
							{link.name}
						</a>
					),
				)
			}
		</nav>
		<a class="pure-drawer__search" href={url("/search/")}>
			<Icon is:inline name="material-symbols:search-rounded" />
			<span>搜索站点内容</span>
		</a>
	</div>
</header>

<script is:inline data-swup-ignore-script>
	(() => {
		// data-swup-ignore-script：@swup/astro 的 SwupScriptsPlugin 会在每次
		// 无刷新换页后重新执行所有内联脚本（scope = document）。导航栏不在
		// swup 容器里、DOM 常驻，重跑只会叠加事件监听——toggle 被绑两次后
		// 点一下开又立刻关，表现为「换页后汉堡点不动，刷新才恢复」。
		// 导航栏常驻 + 所有监听挂 window/document/常驻 DOM，跑一次即可。
		const root = document.getElementById("pure-navbar");
		if (!root) return;

		const toggle = root.querySelector("#pure-menu-switch");
		const drawer = root.querySelector("#pure-drawer");
		const bar = root.querySelector(".pure-navbar__bar");

		const setOpen = (open) => {
			if (!drawer || !toggle) return;
			// 只翻转一个状态位（data-drawer），显隐交给 CSS transition：
			// 不再用 hidden/display 切换 + animation， rapid 连点时状态机是
			// 幂等的，不会出现「点了没反应」的中间态。
			root.dataset.drawer = open ? "open" : "closed";
			toggle.setAttribute("aria-expanded", String(open));
		};

		// onclick 赋值式绑定：即使脚本被重复执行也天然幂等，不会叠加监听
		if (toggle) {
			toggle.onclick = () => {
				setOpen(root.dataset.drawer !== "open");
			};
		}

		// 点击面板外部 / ESC 关闭，且不打断面板内的 details 交互
		document.addEventListener("click", (event) => {
			if (root.dataset.drawer !== "open") return;
			const target = event.target;
			if (!(target instanceof Node)) return;
			if (bar?.contains(target) || drawer?.contains(target)) return;
			setOpen(false);
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && root.dataset.drawer === "open") {
				setOpen(false);
			}
		});

		// 桌面端展开菜单时关闭移动抽屉，避免视口变化后残留
		const desktopQuery = window.matchMedia("(min-width: 1024px)");
		const closeOnDesktop = () => {
			if (desktopQuery.matches) setOpen(false);
		};
		desktopQuery.addEventListener("change", closeOnDesktop);

		// ------------------------------------------------------------------
		// 主内容容器的顶距校正
		// 壁纸定位脚本会在全屏模式下写入内联 margin-top:1rem!important，
		// 而它可能早于 data-site-theme 生效就执行完，于是 Pure 下会多出 16px。
		// 这里按「最终主题」校正一次，并记住 Aemeath 的原始值以便切回时还原。
		// ------------------------------------------------------------------
		let savedMargin = null;
		const syncMainOffset = () => {
			const holder = document.querySelector(".w-full.z-30.pointer-events-none");
			if (!holder) return;
			const pure = document.documentElement.getAttribute("data-site-theme") === "pure";
			if (pure) {
				if (savedMargin === null) {
					savedMargin = {
						value: holder.style.getPropertyValue("margin-top"),
						priority: holder.style.getPropertyPriority("margin-top"),
					};
				}
				holder.style.setProperty("margin-top", "0", "important");
			} else if (savedMargin) {
				if (savedMargin.value) {
					holder.style.setProperty(
						"margin-top",
						savedMargin.value,
						savedMargin.priority || "important",
					);
				} else {
					holder.style.removeProperty("margin-top");
				}
				savedMargin = null;
			}
		};
		syncMainOffset();
		document.addEventListener("site-theme-change", syncMainOffset);
		new MutationObserver(syncMainOffset).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["data-site-theme"],
		});

		// 滚动后才浮出实底面板：与上游 pure-header 的 is-scrolled 一致
		let lastScrolled = null;
		const syncScrolled = () => {
			const scrolled = window.scrollY > 12;
			if (scrolled === lastScrolled) return;
			lastScrolled = scrolled;
			root.classList.toggle("is-scrolled", scrolled);
		};
		syncScrolled();
		window.addEventListener("scroll", syncScrolled, { passive: true });

		// 阅读进度：视口顶部的一条主题色细线
		const progressBar = root.querySelector("#pure-progress");
		const progressFill = root.querySelector("#pure-progress-fill");
		let progressRaf = 0;
		const syncProgress = () => {
			progressRaf = 0;
			if (!progressBar || !progressFill) return;
			const doc = document.documentElement;
			const max = doc.scrollHeight - window.innerHeight;
			const measurable = max > 60;
			const ratio = measurable
				? Math.min(1, Math.max(0, window.scrollY / max))
				: 0;
			progressFill.style.transform = `scaleX(${ratio.toFixed(4)})`;
			progressBar.classList.toggle("is-active", measurable && ratio > 0.001);
		};
		const queueProgress = () => {
			if (progressRaf) return;
			progressRaf = requestAnimationFrame(syncProgress);
		};
		syncProgress();
		window.addEventListener("scroll", queueProgress, { passive: true });
		window.addEventListener("resize", queueProgress);

		// 站内无刷新切页后重算激活态与滚动状态
		const syncActive = () => {
			const path = (window.location.pathname || "/").replace(/\/+$/, "") || "/";
			root.querySelectorAll("[data-pure-path]").forEach((el) => {
				const raw = (el.getAttribute("data-pure-path") || "").replace(/\/+$/, "");
				const value = raw || "/";
				const active =
					value === "/"
						? path === "/"
						: path === value || path.startsWith(value + "/");
				el.classList.toggle("is-current", active);
				if (active) el.setAttribute("aria-current", "page");
				else el.removeAttribute("aria-current");
			});
			root.querySelectorAll(".pure-nav__group, .pure-drawer__group").forEach((group) => {
				const summary = group.querySelector("summary");
				if (summary) summary.classList.toggle("is-current", !!group.querySelector("a.is-current"));
			});
			syncScrolled();
			setOpen(false);
			syncMainOffset();
			syncProgress();
		};

		// Swup 的钩子名带冒号命名空间，且实例可能在脚本执行后才就绪，
		// 因此同时挂 hooks 与 document 事件，并做一次微批处理避免重复计算。
		let syncTimer = 0;
		const scheduleSync = () => {
			window.clearTimeout(syncTimer);
			syncTimer = window.setTimeout(syncActive, 60);
		};
		let hooksBound = false;
		const bindSwupHooks = () => {
			if (hooksBound) return;
			const swup = window.swup;
			if (!swup?.hooks) return;
			hooksBound = true;
			swup.hooks.on("content:replace", scheduleSync);
			swup.hooks.on("page:view", scheduleSync);
		};
		bindSwupHooks();
		document.addEventListener("swup:enable", bindSwupHooks);
		[
			"swup:content:replace",
			"swup:page:view",
			"swup:contentReplaced",
			"swup:pageView",
		].forEach((name) => document.addEventListener(name, scheduleSync));
	})();
</script>
