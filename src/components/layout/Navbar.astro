---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DisplaySettings from "@/components/controls/DisplaySettingsIntegrated.svelte";
import FontSwitch from "@/components/controls/FontSwitch.svelte";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import Search from "@/components/controls/Search.svelte";
import SiteThemeSwitch from "@/components/controls/SiteThemeSwitch.svelte";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import { backgroundWallpaper, navBarConfig, siteConfig } from "@/config";
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { isHomePage } from "@/utils/layout-utils";
import { url } from "@/utils/url-utils";
import DropdownMenu from "./DropdownMenu.astro";
import NavMenuPanel from "./NavMenuPanel.astro";

const className = Astro.props.class;

// 背景视频设置面板数据：与音乐面板一样直接渲染在 Navbar，共用 float-panel 开关机制
const bgPlayerUrls =
	backgroundWallpaper.playerEnable &&
	typeof backgroundWallpaper.src === "object" &&
	!Array.isArray(backgroundWallpaper.src) &&
	backgroundWallpaper.src.playerUrl
		? Array.isArray(backgroundWallpaper.src.playerUrl)
			? backgroundWallpaper.src.playerUrl
			: [backgroundWallpaper.src.playerUrl]
		: [];
const bgPlayerNames = bgPlayerUrls.map((u: string, i: number) => {
	const file = u.split("/").pop() ?? `Video ${i + 1}`;
	return decodeURIComponent(file.replace(/\.[^.]+$/, ""));
});
const hasBgPlayerMultiple = bgPlayerNames.length > 1;
const tVideoSettings = i18n(I18nKey.videoSettings);
const tVideoCycleMode = i18n(I18nKey.videoCycleMode);
const tVideoCycleLoop = i18n(I18nKey.videoCycleLoop);
const tVideoCycleNext = i18n(I18nKey.videoCycleNext);
const tVideoPlaying = i18n(I18nKey.videoPlaying);
const tVideoPrev = i18n(I18nKey.videoPrev);
const tVideoNext = i18n(I18nKey.videoNext);
const tVideoPlay = i18n(I18nKey.videoPlay);
const tVideoPause = i18n(I18nKey.videoPause);

// 获取导航栏透明模式配置
const navbarTransparentMode =
	backgroundWallpaper.mode === "banner"
		? backgroundWallpaper.common?.navbar?.transparentMode || "semi"
		: "semi";

// 获取导航栏毛玻璃效果配置
const navbarEnableBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.enableBlur ?? true)
		: false;

// 获取导航栏模糊度
const navbarBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.blur ?? 20)
		: 0;

// 获取导航栏标题，如果没有设置则使用 siteConfig.title
const navbarTitle = siteConfig.navbar.title || siteConfig.title;

// 获取导航栏宽度配置
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const navbarMenuAlign = siteConfig.navbar.menuAlign ?? "center";
const isNavbarMenuCentered = navbarMenuAlign === "center";

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 检查是否有任何显示设置可用
const showThemeColor = !siteConfig.themeColor.fixed;
const isWallpaperSwitchable = backgroundWallpaper.switchable ?? true;
const allowLayoutSwitch = siteConfig.postListLayout.allowSwitch;
const hasDisplaySettings =
	showThemeColor || isWallpaperSwitchable || allowLayoutSwitch;

// 根据 siteConfig.pages 过滤导航栏链接
const pages = siteConfig.pages;

function isPageEnabled(link: NavBarLink): boolean {
	if (!link.pageKey) return true;
	return pages[link.pageKey as keyof typeof pages] !== false;
}

function filterLinks(link: NavBarLink): NavBarLink | null {
	if (!link.children) {
		return isPageEnabled(link) ? link : null;
	}

	const filteredChildren = link.children.filter(isPageEnabled);

	if (filteredChildren.length === 0) return null;
	// 保留「文章」「关于」这类分组标题，单子项时不再摊平成「分类」「打赏」
	if (filteredChildren.length === 1 && link.url !== "#") return filteredChildren[0];
	return { ...link, children: filteredChildren };
}

let links: NavBarLink[] = navBarConfig.links
	.map(filterLinks)
	.filter((link): link is NavBarLink => link !== null);

// 处理导航栏 Logo 图片
const logoValue = siteConfig.navbar.logo?.value || "";
const isLocalSrcLogo =
	siteConfig.navbar.logo?.type === "image" &&
	logoValue &&
	!logoValue.startsWith("/") &&
	!logoValue.startsWith("http");
let logoImg: ImageMetadata | null = null;

if (isLocalSrcLogo) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", logoValue))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) {
		logoImg = await file();
	}
}
---
<div id="navbar" class="z-50 firefly-navbar" style={`--navbar-glass-blur: ${navbarBlur}px;`} data-transparent-mode={navbarTransparentMode} data-enable-blur={String(navbarEnableBlur)} data-is-home={isHomePageCheck} data-full-width={navbarWidthFull}>
    <div class:list={[
        className,
        "firefly-nav-shell relative overflow-visible! h-18 px-4"
    ]}>
        <div class="nav-container mx-auto h-full w-full grid grid-cols-[auto_minmax(0,1fr)_auto] items-center">
            <a href={url('/')} class="nav-brand btn-plain scale-animation rounded-lg h-13 px-5 font-bold active:scale-95">
                <span class:list={[
                    "brand-name flex flex-row items-center text-md",
                    siteConfig.navbar.followTheme ? "text-(--primary)" : "dark:text-white text-black"
                ]} style="font-family: var(--font-navbar-title, inherit)">
                                    {siteConfig.navbar.logo?.type === "icon" ? (
                                        <Icon is:inline name={siteConfig.navbar.logo.value || "material-symbols:home-pin-outline"} class="text-[1.75rem] mb-1 mr-2" />
                                    ) : siteConfig.navbar.logo?.type === "image" && logoImg ? (
                                        <Picture
                                            src={logoImg}
                                            alt={siteConfig.navbar.logo.alt || siteConfig.title}
                                            class="h-7 w-7 mb-1 mr-2 rounded-md bg-white object-contain ring-1 ring-sky-100/80 dark:ring-white/20"
                                            formats={getImageFormats()}
                                            fallbackFormat={getFallbackFormat()}
                                            widths={[28, 56]}
                                            loading="eager"
                                            fetchpriority="high"
                                        />
                                    ) : siteConfig.navbar.logo?.type === "image" ? (
                                        <img src={url(siteConfig.navbar.logo.value)} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-7 w-7 mb-1 mr-2 rounded-md bg-white object-contain ring-1 ring-sky-100/80 dark:ring-white/20" fetchpriority="high" />
                                    ) : siteConfig.navbar.logo?.type === "url" ? (
                                        <img src={siteConfig.navbar.logo.value} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-7 w-7 mb-1 mr-2 rounded-md bg-white object-contain ring-1 ring-sky-100/80 dark:ring-white/20" fetchpriority="high" />
                                    ) : (
                                        <Icon is:inline name="material-symbols:home-pin-outline" class="text-[1.75rem] mb-1 mr-2" />
                                    )}
                    {navbarTitle}
                </span>
            </a>
            <div class:list={[
                "nav-links hidden lg:flex items-center space-x-1 col-start-2 justify-self-end",
                isNavbarMenuCentered ? "justify-center" : "justify-start"
            ]}>
                {links.map((l) => {
                    return <DropdownMenu link={l} />;
                })}
            </div>
            <div class="nav-actions flex items-center gap-1 col-start-3 justify-self-end min-w-0">
                <!--<SearchPanel client:load>-->
                <Search
                    client:load
                />
                <FontSwitch client:load />
                {musicPlayerConfig.showInNavbar && (
                    <button aria-label={i18n(I18nKey.music)} class="theme-btn btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="music-player-switch">
                        <Icon is:inline name="material-symbols:music-note-rounded" class="text-[1.25rem]"></Icon>
                    </button>
                )}
                {backgroundWallpaper.playerEnable && backgroundWallpaper.mode !== "none" && (
                    <button
                        aria-label={i18n(I18nKey.videoPlay)}
                        class="theme-btn btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
                        id="bg-player-toggle"
                        data-i18n-play={i18n(I18nKey.videoPlay)}
                        data-i18n-pause={i18n(I18nKey.videoPause)}
                    >
                        <Icon is:inline name="material-symbols:play-arrow-rounded" class="text-[1.5rem]" />
                    </button>
                )}
                {hasDisplaySettings && (
                        <button aria-label="Display Settings" class="theme-btn btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                            <Icon is:inline name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                        </button>
                )}
                {/* @ts-ignore */}
                <LightDarkSwitch client:load></LightDarkSwitch>
                <SiteThemeSwitch client:load></SiteThemeSwitch>
                <button aria-label="Menu" aria-controls="nav-menu-panel" aria-expanded="false" name="Nav Menu" class="menu-btn btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90" id="nav-menu-switch">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
        {musicPlayerConfig.showInNavbar && (
            <div id="music-nav-panel" class="float-panel float-panel-closed absolute transition-all right-16 p-2 pt-4.5 w-80 z-50">
                <MusicPlayer />
            </div>
        )}
        {bgPlayerUrls.length > 0 && (
            <div
                id="bg-player-panel"
                class="float-panel float-panel-closed absolute transition-all right-16 p-2 pt-4.5 w-80 z-50"
                role="dialog"
                aria-label={tVideoSettings}
                data-video-names={JSON.stringify(bgPlayerNames)}
                data-i18n-playing={tVideoPlaying}
                data-i18n-play={tVideoPlay}
                data-i18n-pause={tVideoPause}
            >
                <div class="px-2 pb-2 max-h-[72vh] overflow-y-auto custom-scrollbar">
                    <div class="flex items-center justify-between gap-2 mb-2 text-sm font-bold">
                        <span class="flex items-center gap-2">
                            <Icon is:inline name="material-symbols:movie-outline" class="text-[1.15rem] text-(--primary)" />
                            <span>{tVideoSettings}</span>
                        </span>
                        <button type="button" id="bg-panel-close-btn" class="btn-plain w-8 h-8 flex items-center justify-center rounded-lg" aria-label="关闭">
                            <Icon is:inline name="material-symbols:close-rounded" class="text-[1.1rem]" />
                        </button>
                    </div>
                    <div id="bg-player-track-name" class="text-[0.7rem] text-(--content-meta) mb-2 truncate">{tVideoPlaying}：—</div>
                    <div class="mb-2 flex gap-1.5">
                        <button type="button" id="bg-panel-playpause-btn" class="btn-regular flex-1 rounded-lg py-2 text-xs flex items-center justify-center gap-1.5">
                            <Icon is:inline name="material-symbols:play-arrow-rounded" class="text-[1.05rem]" />
                            <span id="bg-panel-playpause-label">{tVideoPlay}</span>
                        </button>
                        {hasBgPlayerMultiple && (
                            <>
                                <button type="button" id="bg-panel-prev-btn" class="btn-regular w-10 rounded-lg py-2 flex items-center justify-center" title={tVideoPrev} aria-label={tVideoPrev}>
                                    <Icon is:inline name="material-symbols:chevron-left-rounded" class="text-[1.1rem]" />
                                </button>
                                <button type="button" id="bg-panel-next-btn" class="btn-regular w-10 rounded-lg py-2 flex items-center justify-center" title={tVideoNext} aria-label={tVideoNext}>
                                    <Icon is:inline name="material-symbols:chevron-right-rounded" class="text-[1.1rem]" />
                                </button>
                            </>
                        )}
                    </div>
                    {hasBgPlayerMultiple && (
                        <div class="mb-2">
                            <div class="text-[0.7rem] font-semibold text-(--content-meta) mb-1.5">播放列表</div>
                            <div id="bg-player-track-list" class="flex flex-col gap-1 max-h-44 overflow-y-auto pr-0.5 custom-scrollbar">
                                {bgPlayerNames.map((name, i) => (
                                    <button type="button" data-track-index={i} class="bg-player-track-btn w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-left text-[0.72rem] transition-colors btn-regular">
                                        <span class="bg-player-track-dot w-1.5 h-1.5 rounded-full bg-(--content-meta) opacity-40 shrink-0"></span>
                                        <span class="truncate flex-1">{i + 1}. {name}</span>
                                    </button>
                                ))}
                            </div>
                        </div>
                    )}
                    <div class="text-[0.7rem] font-semibold text-(--content-meta) mb-1.5">{tVideoCycleMode}</div>
                    <div class="flex flex-col gap-1.5" role="radiogroup" aria-label={tVideoCycleMode}>
                        <button type="button" data-cycle="loop" class="bg-player-cycle-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-xs transition-colors btn-regular">
                            <Icon is:inline name="material-symbols:repeat-rounded" class="text-[1rem] text-(--primary)" />
                            <span class="flex-1">{tVideoCycleLoop}</span>
                            <Icon is:inline name="material-symbols:check-rounded" class="bg-player-cycle-check text-[1rem] text-(--primary) opacity-0" />
                        </button>
                        <button type="button" data-cycle="next" class="bg-player-cycle-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-xs transition-colors btn-regular">
                            <Icon is:inline name="material-symbols:skip-next-rounded" class="text-[1rem] text-(--primary)" />
                            <span class="flex-1">{tVideoCycleNext}</span>
                            <Icon is:inline name="material-symbols:check-rounded" class="bg-player-cycle-check text-[1rem] text-(--primary) opacity-0" />
                        </button>
                    </div>
                </div>
            </div>
        )}
        <DisplaySettings client:load></DisplaySettings>
    </div>
    <!-- Keep the drawer outside the glass shell: backdrop-filter creates a
         containing block for fixed descendants on mobile. -->
    <NavMenuPanel links={links}></NavMenuPanel>
</div>

<script>
function loadButtonScript() {
    // 桥接背景播放器：赋值式函数由 BackgroundPlayer 定义，切页/重复执行天然幂等
    const bgBridge = window as Window & {
        __bgPlayerState?: () => { playing: boolean; index: number; cycle: string };
        __bgPlayerCommand?: (cmd: string, data?: string | number) => void;
    };

    // 播放/暂停图标只原地更新 path 的 d 属性，绝不替换按钮 innerHTML。
    // 替换 innerHTML 会让正在冒泡的 click 事件 target 变成 detached 节点，
    // 被"点击面板外关闭"误判，导致面板刚打开就被立刻关掉（时灵时不灵的根因）。
    const PLAY_ICON_PATH = "M8 17.175V6.825q0-.425.3-.713t.7-.287q.125 0 .263.037t.262.113l8.15 5.175q.225.15.338.375t.112.475t-.112.475t-.338.375l-8.15 5.175q-.125.075-.262.113T9 18.175q-.4 0-.7-.288t-.3-.712";
    const PAUSE_ICON_PATH = "M16 19q-.825 0-1.412-.587T14 17V7q0-.825.588-1.412T16 5t1.413.588T18 7v10q0 .825-.587 1.413T16 19m-8 0q-.825 0-1.412-.587T6 17V7q0-.825.588-1.412T8 5t1.413.588T10 7v10q0 .825-.587 1.413T8 19";

    function syncVideoPanelUI(detail?: { playing: boolean; index: number; cycle: string }) {
        const panel = document.getElementById("bg-player-panel");
        if (!panel) return;
        const state = detail || (bgBridge.__bgPlayerState ? bgBridge.__bgPlayerState() : null);
        if (!state) return;
        let names: string[] = [];
        try { names = JSON.parse(panel.getAttribute("data-video-names") || "[]"); } catch (e) { names = []; }
        const labelPlaying = panel.getAttribute("data-i18n-playing") || "正在播放";
        const labelPlay = panel.getAttribute("data-i18n-play") || "播放";
        const labelPause = panel.getAttribute("data-i18n-pause") || "暂停";

        const playing = !!state.playing;
        const ppLabel = document.getElementById("bg-panel-playpause-label");
        if (ppLabel) ppLabel.textContent = playing ? labelPause : labelPlay;
        const ppPath = document.querySelector("#bg-panel-playpause-btn svg path");
        if (ppPath) ppPath.setAttribute("d", playing ? PAUSE_ICON_PATH : PLAY_ICON_PATH);

        const trackName = document.getElementById("bg-player-track-name");
        if (trackName) trackName.textContent = labelPlaying + "：" + (names[state.index] || "Video " + (state.index + 1));

        document.querySelectorAll(".bg-player-track-btn").forEach(function (btn) {
            const active = Number(btn.getAttribute("data-track-index")) === state.index;
            btn.classList.toggle("active", active);
            const dot = btn.querySelector(".bg-player-track-dot");
            if (dot) (dot as HTMLElement).style.opacity = active ? "1" : "0.4";
        });
        document.querySelectorAll(".bg-player-cycle-btn").forEach(function (btn) {
            const active = btn.getAttribute("data-cycle") === state.cycle;
            btn.classList.toggle("active", active);
            const check = btn.querySelector(".bg-player-cycle-check");
            if (check) (check as HTMLElement).style.opacity = active ? "1" : "0";
        });
    }

    function setMobileMenuOpen(open: boolean) {
        let menuPanel = document.getElementById("nav-menu-panel");
        let menuButton = document.getElementById("nav-menu-switch");
        if (!menuPanel) return;

        menuPanel.classList.toggle("float-panel-closed", !open);
        menuPanel.classList.toggle("active", open);
        menuPanel.setAttribute("aria-hidden", String(!open));
        menuButton?.classList.toggle("active", open);
        menuButton?.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
    }

    (window as Window & { __fireflySetMobileMenuOpen?: (open: boolean) => void })
        .__fireflySetMobileMenuOpen = setMobileMenuOpen;

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                setMobileMenuOpen(!menuPanel.classList.contains("active"));
            }
        };
    }

    let musicBtn = document.getElementById("music-player-switch");
    if (musicBtn) {
        musicBtn.onclick = function () {
            let musicPanel = document.getElementById("music-nav-panel");
            if (musicPanel) {
                musicPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    // 背景视频播放器控制按钮
    let bgPlayerBtn = document.getElementById("bg-player-toggle");
    if (bgPlayerBtn) {
        bgPlayerBtn.onclick = function () {
            // 手机/平板竖屏：播放按钮只管播放/暂停，不弹设置面板。
            // 面板（w-80）会盖在视频带右半区，且「点外关闭」会吞掉紧随其后的
            // 第一次点按，正是手机端左右切换按钮「点了没反应」的根因。
            if (window.matchMedia("(max-width: 1023px)").matches) {
                if (bgBridge.__bgPlayerCommand) bgBridge.__bgPlayerCommand("toggle");
                return;
            }
            const panel = document.getElementById("bg-player-panel");
            if (!panel) return;
            panel.classList.toggle("float-panel-closed");
            if (!panel.classList.contains("float-panel-closed")) {
                syncVideoPanelUI();
                const st = bgBridge.__bgPlayerState ? bgBridge.__bgPlayerState() : null;
                if (st && !st.playing && bgBridge.__bgPlayerCommand) bgBridge.__bgPlayerCommand("play");
            }
        };
        window.addEventListener("bg-player-state-change", function (e) {
            var ce = e as CustomEvent;
            var playing = !!(ce.detail && ce.detail.playing);
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            // 只更新 path 的 d，不替换 innerHTML —— 否则冒泡中的 click target 会 detached
            var path = bgPlayerBtn!.querySelector("svg path");
            if (path) path.setAttribute("d", playing ? PAUSE_ICON_PATH : PLAY_ICON_PATH);
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
            syncVideoPanelUI(ce.detail);
        });
        // 切换壁纸模式时隐藏/显示播放按钮
        window.addEventListener("wallpaperModeChange", function (e) {
            var ce = e as CustomEvent;
            var mode = ce.detail && ce.detail.mode;
            bgPlayerBtn!.style.display = mode === "none" ? "none" : "";
        });
        // Swup 导航时同步播放按钮状态（BackgroundPlayer 可能被重建，也可能持久存在）
        function syncBgPlayerBtn() {
            var st = bgBridge.__bgPlayerState ? bgBridge.__bgPlayerState() : null;
            var playing = st ? !!st.playing : document.documentElement.hasAttribute("data-bg-video-playing");
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            var path = bgPlayerBtn!.querySelector("svg path");
            if (path) path.setAttribute("d", playing ? PAUSE_ICON_PATH : PLAY_ICON_PATH);
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
            syncVideoPanelUI(st || undefined);
        }
        if (window.swup && window.swup.hooks) {
            window.swup.hooks.on("content:replace", syncBgPlayerBtn);
        } else {
            document.addEventListener("swup:enable", function () {
                window.swup.hooks.on("content:replace", syncBgPlayerBtn);
            });
        }
    }

    // 亮暗色开关与站点主题开关已改为自包含 Svelte 组件（自带开合/外点关闭），
    // 不再在此处按 getElementById 绑定——两套导航栏各挂一份组件，
    // 全局按 ID 绑定只会命中第一份，Pure 主题下那份永远点不开。

    document.addEventListener("click", function(event) {
        const panels = ["display-setting", "nav-menu-panel", "music-nav-panel", "bg-player-panel"];
        const buttons = ["display-settings-switch", "nav-menu-switch", "music-player-switch", "bg-player-toggle"];

        panels.forEach((id, index) => {
            const panel = document.getElementById(id);
            const button = document.getElementById(buttons[index]);
            if (panel && button && !panel.classList.contains("float-panel-closed")) {
                if (event.target instanceof Node && !panel.contains(event.target) && !button.contains(event.target)) {
                    if (id === "nav-menu-panel") {
                        setMobileMenuOpen(false);
                    } else {
                        panel.classList.add("float-panel-closed");
                    }
                }
            }
        });
    });

    // 视频设置面板内部控件：与其它面板一样用 onclick 赋值，天然幂等
    const videoCmd = function (c: string, d?: string | number) {
        if (bgBridge.__bgPlayerCommand) bgBridge.__bgPlayerCommand(c, d);
    };
    const closeVideoPanelBtn = document.getElementById("bg-panel-close-btn");
    if (closeVideoPanelBtn) closeVideoPanelBtn.onclick = function () {
        document.getElementById("bg-player-panel")?.classList.add("float-panel-closed");
    };
    const playPauseBtn = document.getElementById("bg-panel-playpause-btn");
    if (playPauseBtn) playPauseBtn.onclick = function () { videoCmd("toggle"); };
    const panelPrevBtn = document.getElementById("bg-panel-prev-btn");
    if (panelPrevBtn) panelPrevBtn.onclick = function () { videoCmd("prev"); };
    const panelNextBtn = document.getElementById("bg-panel-next-btn");
    if (panelNextBtn) panelNextBtn.onclick = function () { videoCmd("next"); };
    document.querySelectorAll(".bg-player-track-btn").forEach(function (btn) {
        (btn as HTMLElement).onclick = function () { videoCmd("track", btn.getAttribute("data-track-index") || undefined); };
    });
    document.querySelectorAll(".bg-player-cycle-btn").forEach(function (btn) {
        (btn as HTMLElement).onclick = function () { videoCmd("cycle", btn.getAttribute("data-cycle") || undefined); };
    });
}

loadButtonScript();

function normalizeNavPath(path: string) {
    var pathname = (path || "/").split(/[?#]/)[0] || "/";
    try {
        if (/^https?:\/\//.test(pathname)) {
            pathname = new URL(pathname).pathname;
        }
    } catch (_) {}
    if (!pathname.startsWith("/")) pathname = "/" + pathname;
    var basePath = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
    if (basePath && basePath !== "/" && pathname.startsWith(basePath)) {
        pathname = pathname.slice(basePath.length) || "/";
    }
    return pathname.length > 1 ? pathname.replace(/\/+$/g, "") : "/";
}

function navPathMatches(currentPath: string, candidatePath: string) {
    if (!candidatePath) return false;
    if (candidatePath === "/") return currentPath === "/";
    return currentPath === candidatePath || currentPath.startsWith(candidatePath + "/");
}

function syncNavbarActiveState() {
    var currentPath = normalizeNavPath(window.location.pathname);

    document.querySelectorAll("[data-nav-item]").forEach(function(item) {
        var paths = (item.getAttribute("data-active-paths") || "").split("|").filter(Boolean);
        var active = paths.some(function(path) {
            return navPathMatches(currentPath, path);
        });
        var link = item.querySelector(".navbar-link");
        if (!link) return;
        link.classList.toggle("nav-link-active", active);
        link.classList.toggle("active", active);
        if (active) {
            link.setAttribute("aria-current", "page");
        } else {
            link.removeAttribute("aria-current");
        }
    });

    document.querySelectorAll("[data-mobile-nav-item]").forEach(function(item) {
        var paths = (item.getAttribute("data-active-paths") || "").split("|").filter(Boolean);
        var active = paths.some(function(path) {
            return navPathMatches(currentPath, path);
        });
        if (item.classList.contains("mobile-link")) {
            item.classList.toggle("mobile-nav-active", active);
            if (active) {
                item.setAttribute("aria-current", "page");
            } else {
                item.removeAttribute("aria-current");
            }
        }
        if (item.classList.contains("mobile-nav-group")) {
            item.classList.toggle("mobile-nav-group-active", active);
        }
    });

    // 桌面下拉子项：SSR 高亮在 Swup 无刷新切页后不会更新，这里统一重算，
    // 避免「我看过的作品 / 我的B站收藏」等高亮残留、互相串。
    document.querySelectorAll("[data-nav-path]").forEach(function(item) {
        var path = (item.getAttribute("data-nav-path") || "").trim();
        if (!path) return;
        var active = navPathMatches(currentPath, path);
        item.classList.toggle("dropdown-item-active", active);
        item.classList.toggle("current-theme-btn", active);
        if (active) {
            item.setAttribute("aria-current", "page");
        } else {
            item.removeAttribute("aria-current");
        }
    });
}

syncNavbarActiveState();
document.addEventListener("astro:page-load", syncNavbarActiveState);
document.addEventListener("swup:contentReplaced", syncNavbarActiveState);
document.addEventListener("click", function(event) {
    var target = event.target;
    if (!(target instanceof Element)) return;
    var link = target.closest("a[href]");
    if (!link) return;
    var href = link.getAttribute("href") || "";
    if (!href || href.startsWith("#") || /^https?:\/\//.test(href)) return;
    window.setTimeout(syncNavbarActiveState, 80);
    window.setTimeout(syncNavbarActiveState, 240);
});
window.addEventListener("popstate", syncNavbarActiveState);
window.addEventListener("hashchange", syncNavbarActiveState);

// 为semifull模式添加滚动检测逻辑
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const transparentMode = navbar.getAttribute('data-transparent-mode');
    if (transparentMode !== 'semifull') return;

    // 无论首页/非首页，semifull 都由滚动位置决定是否进入 scrolled 状态
    // 先移除之前的滚动监听器，避免重复绑定
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
        window.semifullScrollHandler = undefined;
    }

    // 初始状态不强制加 scrolled，保持透明；滚动后再切换
    navbar.classList.remove('scrolled');

    let ticking = false;

    function updateNavbarState() {
        if (document.documentElement.classList.contains('is-page-transitioning')) {
            navbar!.classList.remove('scrolled');
            ticking = false;
            return;
        }

        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const threshold = 50; // 滚动阈值，可以根据需要调整
        // 使用批量DOM操作优化性能
        if (scrollTop > threshold) {
            navbar!.classList.add('scrolled');
        } else {
            navbar!.classList.remove('scrolled');
        }

        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }

    // 移除之前的滚动事件监听器（如果存在）
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
    }

    // 保存新的事件处理器引用
    window.semifullScrollHandler = requestTick as unknown as (() => void);

    // 监听滚动事件
    window.addEventListener('scroll', requestTick, { passive: true });

    // 初始化状态
    updateNavbarState();
}

// 将函数暴露到全局对象，供页面切换时调用
window.initSemifullScrollDetection = initSemifullScrollDetection;

// 页面加载完成后初始化滚动检测
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

