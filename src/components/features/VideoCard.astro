---
/**
 * 文章内嵌视频卡片
 *
 * 用法（在 .mdx 文章中）：
 *   import VideoCard from "@/components/features/VideoCard.astro";
 *   <VideoCard src="/assets/videos/xxx.mp4" poster="/assets/images/xxx.webp" title="视频标题" />
 *
 * - src:    视频地址（public 下的路径或远程 URL）
 * - poster: 封面图地址；未播放时显示，点击后播放
 * - title:  可选的标题，显示在封面下方
 */
interface Props {
	src: string;
	poster?: string;
	title?: string;
}

const { src, poster = "", title = "" } = Astro.props;
const uid = `video-card-${Math.random().toString(36).slice(2, 9)}`;
---

<figure id={uid} class="video-card group relative my-6 overflow-hidden rounded-xl border border-(--line-divider) bg-black/5">
	<div class="video-card-stage relative w-full overflow-hidden bg-black">
		<video
			class="video-card-media absolute inset-0 h-full w-full object-contain"
			preload="metadata"
			playsinline
			webkit-playsinline
			x5-playsinline
			controls
			poster={poster || undefined}
			src={src}
		></video>
		{poster && (
			<img
				class="video-card-poster absolute inset-0 z-[5] h-full w-full object-contain pointer-events-none"
				src={poster}
				alt={title || "视频封面"}
				loading="lazy"
				aria-hidden="true"
			/>
		)}
		{poster && (
			<button
				type="button"
				class="video-card-play absolute inset-0 z-10 flex items-center justify-center cursor-pointer bg-transparent border-0 transition-opacity duration-300"
				aria-label="播放视频"
			>
				<span class="video-card-play-btn flex h-16 w-16 items-center justify-center rounded-full bg-black/55 text-white shadow-lg backdrop-blur-sm transition-transform duration-200 group-hover:scale-110">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="ml-0.5 h-8 w-8" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.4-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z" /></svg>
				</span>
			</button>
		)}
	</div>
	{title && <figcaption class="video-card-caption px-1 pt-2 text-center text-xs text-(--content-meta)">{title}</figcaption>}
</figure>

<style>
	/* 默认 16:9 兜底；元数据加载后 JS 按视频真实比例覆盖，保证任何比例完整显示 */
	.video-card-stage {
		aspect-ratio: 16 / 9;
	}
	.video-card-play-btn {
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
	}
	.video-card.is-playing .video-card-play {
		opacity: 0;
		pointer-events: none;
	}
	.video-card.is-playing .video-card-poster {
		opacity: 0;
	}
	.video-card-poster {
		transition: opacity 300ms ease;
	}
</style>

<script is:inline define:vars={{ uid }}>
	(() => {
		var root = document.getElementById(uid);
		if (!root) return;
		var video = root.querySelector(".video-card-media");
		var playBtn = root.querySelector(".video-card-play");
		var stage = root.querySelector(".video-card-stage");
		var posterImg = root.querySelector(".video-card-poster");
		// 按视频真实比例自适应容器：横屏保持全宽，竖屏/方图限制高度避免霸屏
		var fitStage = function (w, h) {
			if (!stage || !w || !h) return;
			var ratio = w / h;
			stage.style.aspectRatio = String(ratio);
			var isPortrait = ratio < 1;
			// 竖屏视频限制视口高度，超宽屏限制视口宽度，保证完整显示
			if (isPortrait) {
				stage.style.maxHeight = "72vh";
				stage.style.maxWidth = "100%";
				stage.style.margin = "0 auto";
				stage.style.width = "min(100%, calc(72vh * " + ratio.toFixed(4) + "))";
			} else if (ratio > 2.2) {
				stage.style.maxHeight = "48vh";
			}
		};
		if (video) {
			if (video.videoWidth && video.videoHeight) {
				fitStage(video.videoWidth, video.videoHeight);
			} else {
				video.addEventListener(
					"loadedmetadata",
					function () {
						fitStage(video.videoWidth, video.videoHeight);
					},
					{ once: true }
				);
			}
		}
		// 元数据到达前先用封面图比例设定舞台（封面与视频同比例），移动端
		// preload=metadata 较慢时可立即有正确尺寸，避免先 16:9 再跳变。
		if (posterImg && stage && !stage.style.aspectRatio) {
			var applyPoster = function () {
				if (stage.style.aspectRatio) return;
				if (posterImg.naturalWidth && posterImg.naturalHeight) {
					fitStage(posterImg.naturalWidth, posterImg.naturalHeight);
				}
			};
			if (posterImg.complete) applyPoster();
			else posterImg.addEventListener("load", applyPoster, { once: true });
		}
		if (video && playBtn) {
			var start = function () {
				root.classList.add("is-playing");
				var p = video.play();
				if (p && p.catch) p.catch(function () {});
			};
			playBtn.addEventListener("click", start);
			// 移动端：没有封面按钮时也能点视频区域直接播放
			if (!playBtn) video.addEventListener("click", start);
			video.addEventListener("play", function () {
				root.classList.add("is-playing");
			});
		}
	})();
</script>
